generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id      String    @id @default(uuid())
  name    String
  Product Product[]
}

model Product {
  id           String         @id @default(uuid())
  description  String
  inStock      Int
  price        Float          @default(0)
  slug         String         @unique
  tags         String[]       @default([])
  gender       Gender
  categoryId   String
  title        String
  // Tallas u opciones libres: ["S","M"], ["38","39"], ["100 ml"] o vacío (sin opciones)
  Size         String[]       @default([])
  category     Category       @relation(fields: [categoryId], references: [id])
  ProductImage ProductImage[]

  @@index([gender])
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  url       String
  productId String
  product   Product @relation(fields: [productId], references: [id])
}

model User {
  id            String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  name          String
  email         String    @unique
  emailVerified DateTime? @db.Timestamp(6)
  password      String
  role          Role      @default(user)
  image         String?
}

enum Gender {
  men
  women
  kid
  unisex
}

enum Role {
  admin
  user
}
