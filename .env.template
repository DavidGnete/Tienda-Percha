# Copia este archivo como .env y reemplaza los valores de ejemplo.
# Nunca subas el archivo .env al repositorio.
# NO pongas valores reales en este archivo: se sube a git.

# --- Base de datos (PostgreSQL local con docker-compose) ---
DB_USER=percha_dev
DB_PASSWORD=cambia_esta_clave
DB_NAME=percha_db

# Debe coincidir con los valores de arriba (puerto 5433, ver docker-compose.yml)
DATABASE_URL="postgresql://percha_dev:cambia_esta_clave@localhost:5433/percha_db"

# --- NextAuth ---
# Genera uno nuevo con: npx auth secret
AUTH_SECRET=genera_uno_con_npx_auth_secret

# --- Cloudinary (subida de imágenes) ---
# Formato: cloudinary://<API_KEY>:<API_SECRET>@<CLOUD_NAME>
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# --- Usuario administrador (npm run create-admin) ---
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=cambia_esta_clave_admin
